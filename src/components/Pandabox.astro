---
import { Image } from 'astro:assets';
import { type CollectionEntry, getEntry } from 'astro:content';

interface Props {
  galleryid: string;
  gallery?: CollectionEntry<'galleries'>;
  transitionType?: string;
  width?: string;
  aspect?: number;
  thumbnailHeight?: string;
  thumbnailAspect?: number;
  float?: 'left' | 'right' | 'none';
}

const { galleryid, transitionType, width, aspect, thumbnailHeight, thumbnailAspect, float } = Astro.props;
const gallery = await getEntry('galleries', galleryid);
const images = gallery?.data.images ?? [];

// Build inline styles for width, thumbnailHeight, and float
const galleryStyles: Record<string, string> = {};
if (width) {
  galleryStyles['--gallery-width'] = width;
  galleryStyles['max-width'] = width;
}
if (aspect) {
  galleryStyles['--gallery-aspect'] = String(aspect);
}
if (thumbnailHeight) {
  galleryStyles['--thumbnail-height'] = thumbnailHeight;
}
if (thumbnailAspect) {
  galleryStyles['--thumbnail-aspect'] = String(thumbnailAspect);
}
if (float && float !== 'none') {
  galleryStyles['float'] = float;
  galleryStyles['margin'] = float === 'left' ? '0 1.5rem 1rem 0' : '0 0 1rem 1.5rem';
}
const styleString = Object.entries(galleryStyles).map(([k, v]) => `${k}: ${v}`).join('; ');
---

<section class="pandabox-gallery" id={'gallery-' + galleryid} style={styleString || undefined}>
  <!-- Current/Main Image Display -->
  <div class="current-image-container">
    <button class="nav-arrow prev-arrow" aria-label="Previous image">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
        <path fill="currentColor" d="M20 24l-8-8 8-8 1.414 1.414L14.828 16l6.586 6.586z"/>
      </svg>
    </button>
    {
      images.map((image, index) => (
        <button
          class={`current-image-button ${index === 0 ? 'active' : ''}`}
          data-index={index}
          aria-label={`Open lightbox for image ${index + 1}: ${image.alt}`}
        >
          <Image
            src={image.src}
            alt={image.alt}
            layout="constrained"
            width={800}
            quality={85}
            loading={index === 0 ? 'eager' : 'lazy'}
            class="current-image"
            data-index={index}
          />
          {image.title && <div class="current-image-caption">{image.title}</div>}
        </button>
      ))
    }
    <button class="nav-arrow next-arrow" aria-label="Next image">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
        <path fill="currentColor" d="M12 8l8 8-8 8-1.414-1.414L17.172 16l-6.586-6.586z"/>
      </svg>
    </button>
  </div>

  <!-- Thumbnail Strip -->
  <div class="thumbnail-strip">
    <div class="thumbnail-strip-inner">
    {
      images.map((image, index) => (
        <button
          class={`thumbnail-button ${index === 0 ? 'active' : ''}`}
          data-index={index}
          aria-label={`View image ${index + 1}: ${image.alt}`}
        >
          <Image
            src={image.src}
            alt={image.alt}
            layout="constrained"
            width={120}
            quality={60}
            loading="eager"
            data-index={index}
            class="thumbnail"
          />
        </button>
      ))
    }
    </div>
  </div>
  <dialog class="lightbox-dialog" data-option={transitionType || 'fade'}>
    <div class="lightbox-content">
      {
        images.map((image, index) => (
          <figure class="lightbox-image-container" id={`${galleryid}-image-${index}`}>
            {/* For performance, only the first few images are eager loaded, if we rely on lazy only there is a glitch on Chromoum browsers as the image is loaded. */}
            <div class="lightbox-image-wrapper">
              <Image
                src={image.src}
                alt={image.alt}
                layout="full-width"
                quality={90}
                loading={index < 4 ? 'eager' : 'lazy'}
                class="lightbox-image"
                data-index={index}
              />
            </div>
            <figcaption class="lightbox-caption">
              {image.title ? (
                <p>
                  {index + 1}. {image.title}
                </p>
              ) : null}
              {image.description ? <p>{image.description}</p> : null}
            </figcaption>
          </figure>
        ))
      }
    </div>
    <!-- Navigation buttons -->
    <button class="prev-button" aria-label="previous slide">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M16 2a14 14 0 1 0 14 14A14 14 0 0 0 16 2m8 15H11.85l5.58 5.573L16 24l-8-8l8-8l1.43 1.393L11.85 15H24Z"
        >
        </path>
        <path
          fill="none"
          d="m16 8l1.43 1.393L11.85 15H24v2H11.85l5.58 5.573L16 24l-8-8z"
        ></path>
      </svg>
    </button>
    <button class="next-button" aria-label="next slide">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M2 16A14 14 0 1 0 16 2A14 14 0 0 0 2 16m6-1h12.15l-5.58-5.607L16 8l8 8l-8 8l-1.43-1.427L20.15 17H8Z"
        >
        </path>
        <path
          fill="none"
          d="m16 8l-1.43 1.393L20.15 15H8v2h12.15l-5.58 5.573L16 24l8-8z"
        ></path>
      </svg>
    </button>
    <button class="close-button" aria-label="close button">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M16 2C8.2 2 2 8.2 2 16s6.2 14 14 14s14-6.2 14-14S23.8 2 16 2m5.4 21L16 17.6L10.6 23L9 21.4l5.4-5.4L9 10.6L10.6 9l5.4 5.4L21.4 9l1.6 1.6l-5.4 5.4l5.4 5.4z"
        >
        </path>
      </svg>
    </button>
  </dialog>
</section>

<style>
  /* Lightbox Configuration */
  .lightbox-dialog {
    /* Adjust these custom properties if you like */
    --duration-zoom-in: 0.75s; /* Duration of the zoom effect */
    --duration-background-transition: 0.3s; /* Duration of lightbox background transition*/
    --duration-slide-transition: 0.3s; /* Duration of slide transition*/
    --duration-close-transition: 0.5s; /* close*/
    --caption-height: 5lh; /* use line height units for size of caption area */
    --ease-zoom: cubic-bezier(0.5, -0.5, 0.1, 1.5);
    --ease-slide-transition: cubic-bezier(0.9, 0, 0.1, 1);
  }
  @media (prefers-reduced-motion) {
    /* Set  tranistion speed to 0*/
    .lightbox-dialog {
      --duration-zoom-in: 0s;
      --duration-slide-transition: 0s;
      --duration-background-transition: 0s;
      --duration-close-transition: 0s;
    }
  }

  img,
  picture {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Prevent interaction with page when modal is open. */
  html:has(dialog[open]) {
    overflow: hidden;
  }

  /* Main gallery container */
  .pandabox-gallery {
    --gallery-width: 900px;
    --gallery-aspect: 1.6;
    --thumbnail-height: 60px;
    --thumbnail-aspect: 1.333;
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-width: var(--gallery-width);
    margin: 0 auto;
  }

  /* When gallery has float, don't center it */
  .pandabox-gallery[style*="float"] {
    margin: 0;
  }

  /* Current/Main Image Container */
  .current-image-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(20% 0 0);
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: var(--gallery-aspect);
    max-height: 500px;
  }

  .current-image-button {
    display: none;
    position: relative;
    cursor: zoom-in;
    border: none;
    background: none;
    padding: 0;
    height: 100%;
    max-width: 100%;
    &.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    &:focus {
      outline: 2px solid oklch(70% 0.15 200);
      outline-offset: 2px;
    }
    picture, img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
  }

  .current-image {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  .current-image-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem 1rem;
    margin: 0;
    text-align: left;
    color: oklch(95% 0 0);
    background: oklch(0% 0 0 / 60%);
    font-size: 0.9rem;
  }

  /* Navigation Arrows on Current Image */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: oklch(0% 0 0 / 50%);
    border: none;
    border-radius: 50%;
    padding: 0.33rem;
    cursor: pointer;
    transition: background 0.2s ease;
    &:hover {
      background: oklch(0% 0 0 / 80%);
    }
    svg {
      display: block;
      color: oklch(90% 0 0);
      width: 16px;
      height: 16px;
    }
  }

  .prev-arrow {
    left: 1rem;
  }

  .next-arrow {
    right: 1rem;
  }

  /* Thumbnail Strip */
  .thumbnail-strip {
    display: block;
    overflow-x: auto;
    padding: 0.25rem 0.5rem;
    background: oklch(15% 0 0);
    border-radius: 8px;
    scrollbar-width: thin;
    scrollbar-color: oklch(40% 0 0) oklch(20% 0 0);
    text-align: center;
  }

  .thumbnail-strip-inner {
    display: inline-flex;
    gap: 0.5rem;
  }

  .thumbnail-button {
    flex-shrink: 0;
    cursor: pointer;
    outline: none;
    border: 2px solid transparent;
    background: none;
    padding: 0;
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0.6;
    &:hover {
      opacity: 1;
    }
    &.active {
      border-color: oklch(70% 0.15 200);
      opacity: 1;
    }
    &:focus {
      outline: none;
      border-color: oklch(70% 0.15 200);
    }
  }

  .thumbnail {
    width: calc(var(--thumbnail-height) * var(--thumbnail-aspect));
    height: var(--thumbnail-height);
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .pandabox-gallery {
      --thumbnail-height: 45px;
    }
    .current-image-container {
      max-height: 300px;
    }
    .nav-arrow {
      padding: 0.167rem;
      svg {
        width: 13px;
        height: 13px;
      }
    }
    .prev-arrow {
      left: 0.5rem;
    }
    .next-arrow {
      right: 0.5rem;
    }
    /* On mobile, don't float - stack instead */
    .pandabox-gallery[style*="float"] {
      float: none !important;
      margin: 1rem 0 !important;
      max-width: 100% !important;
    }
  }

  /* Lightbox and children */

  /* Exit State */

  .lightbox-dialog {
    display: none;
    transform: translateX(100%);
    opacity: 0;
    /* For exit */

    transition:
      overlay 1s ease-in allow-discrete,
      display 1s ease-in allow-discrete;
    border: none;
    background: none;
    padding: 0;
    overflow: clip;
  }
  @media (width <= 640px) {
    /* Set to zero for mobile for now */

    .lightbox-dialog {
      transition:
        overlay 0s ease-in allow-discrete,
        display 0s ease-in allow-discrete;
    }
  }
  /* Open state */
  .lightbox-dialog[open] {
    display: grid;
    grid-template-rows: [main-start] 5ch [interior-start] 1fr [interior-end] 5ch [main-end];
    grid-template-columns: [main-start] 10ch [interior-start] 1fr[interior-end] 10ch [main-end];
    /* named grid areas used for navigation positioning */
    grid-template-areas:
      'tlhs top trhs'
      'clhs content crhs'
      'blhs bottom brhs';
    transform: translateX(0); /* Slide in */
    opacity: 1;
    width: 80vw;
    max-width: 80vw;
    height: 80dvh;
    max-height: 80dvh;
    margin: auto;
    inset: 0;
  }

  /* Before opening  */
  @starting-style {
    .lightbox-dialog[open] {
      translate: 0 100vh;
    }
    .lightbox-dialog[open]::backdrop {
      opacity: 0;
    }
    .lightbox-dialog[open]
      .lightbox-content
      .lightbox-image-container
      .lightbox-caption {
      opacity: 0;
    }
    .lightbox-dialog[open] button {
      opacity: 0;
    }
  }
  /* Open State*/
  .lightbox-dialog[open]::backdrop {
    opacity: 1;
  }

  /* Exit State */
  .lightbox-dialog::backdrop {
    opacity: 0;
    background: oklch(40% 0 0 / 95%);
    /* Blur background if using semi-transparent background */
    /* backdrop-filter: blur(5px); */
  }
  @starting-style {
    .lightbox-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  /* When dialog is closing */
  .lightbox-dialog.closing::backdrop {
    opacity: 0;
    transition: opacity var(--duration-close-transition) ease;
  }
  .lightbox-dialog.closing {
    opacity: 0;
    transition: opacity var(--duration-close-transition) ease;
  }

  /* Lightbox Content */
  .lightbox-content {
    display: grid;
    grid-template-rows: 1fr;
    grid-template-columns: 1fr;
    grid-template-areas: 'content';
    grid-row-start: main-start;
    grid-row-end: main-end;
    grid-column-start: main-start;
    grid-column-end: main-end;
    width: 100%;
    height: 100%;
  }

  /* Initial state for the image */
  .lightbox-image-container {
    display: grid;
    grid-template-rows: 1fr var(--caption-height);
    grid-template-columns: 1fr;
    grid-template-areas:
      'image'
      'caption';
    grid-area: content;
    place-content: center;
    opacity: 0;
    /* Slide switch transitions, opacity is used in fade mode, transform in slide */
    transition:
      opacity var(--duration-slide-transition) var(--ease-slide-transition),
      transform var(--duration-slide-transition) var(--ease-slide-transition); /* Open-props transition to liven it up a bit */
    pointer-events: none;

    &.active {
      opacity: 1;
      pointer-events: auto;
    }
    .lightbox-image-wrapper {
      grid-area: image;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .lightbox-caption {
      grid-area: caption;
      opacity: 1;
      transition: opacity var(--duration-background-transition) ease-in;
      padding: 1ch;
    }
    .lightbox-image {
      /* Custom properties, origin and scale are modified by JS  */
      --initial-scale: 1;
      --initial-x: 0px;
      --initial-y: 0px;
      --final-x: 0px;
      --final-y: 0px;
      --final-scale: 1;
      transform-origin: center center;
      opacity: 1;
      width: auto;
      max-width: 100%;

      /* end of custom props */
      max-height: calc(80dvh - var(--caption-height));
    }
  }
  @keyframes zoom-in-animation {
    from {
      transform: translate(var(--initial-x), var(--initial-y))
        scale(var(--initial-scale));
    }
    to {
      transform: translate(var(--final-x), var(--final-y))
        scale(var(--final-scale));
    }
  }
  @keyframes zoom-out-animation {
    from {
      transform: translate(var(--final-x), var(--final-y))
        scale(var(--final-scale));
    }
    to {
      transform: translate(var(--initial-x), var(--initial-y))
        scale(var(--initial-scale));
    }
  }

  /* Styling for fade and slide transitions  */
  .lightbox-dialog[data-option='fade'] .lightbox-image-container {
    transform: none;
  }

  .lightbox-dialog[data-option='slide'] .lightbox-image-container {
    transform: translateX(100%);
  }

  .lightbox-dialog[data-option='slide'] .lightbox-image-container.previous {
    transform: translateX(-100%);
  }

  .lightbox-dialog[data-option='slide'] .lightbox-image-container.next {
    transform: translateX(100%);
  }

  .lightbox-dialog[data-option='slide'] .lightbox-image-container.active {
    transform: translateX(0%);
  }

  /* Slide caption */
  .lightbox-caption {
    p {
      margin: auto;
      color: oklch(95% 0 0);
      font-weight: 200;
      text-align: center;
      text-wrap: pretty;
    }
    /* Image title */
    p:first-child {
      padding-block-start: 1.5rem;
      padding-block-end: 0.75rem;
      font-weight: 800;
    }
  }

  /* Navigation Buttons */
  .lightbox-dialog {
    button {
      opacity: 1;
      z-index: 999;
      transition: opacity var(--duration-background-transition) ease-in
        allow-discrete;
      outline: none;
      border: none;
      /* Style the SVG  icons*/
      svg {
        transition: all 0.2s ease-in-out;
        padding: 0;
        aspect-ratio: 1 / 1;
        width: 38px;
        height: 100%;
        color: oklch(60% 0.01 150 / 75%);
      }
      &:hover svg {
        color: oklch(85% 0.15 150 / 95%);
      }
    }
  }
  .prev-button,
  .next-button,
  .close-button {
    display: block;
    cursor: pointer;
    background: none;
  }

  .prev-button {
    grid-area: clhs;
    padding-right: 50%;
  }
  .next-button {
    grid-area: crhs;
    padding-left: 50%;
  }
  .close-button {
    grid-area: trhs;
    cursor: zoom-out;
    padding-left: 50%;
  }
</style>

<script>
  // Scoped gallery controller - each gallery instance gets its own state
  document.addEventListener('astro:page-load', () => {
    const debug = import.meta.env.DEV;
    let resizeTimeout: number | undefined;

    // Track the currently active gallery for keyboard/swipe navigation
    let activeGalleryId: string | null = null;

    function calculateCentering(image: HTMLImageElement): void {
      const wrapper = image.closest('.lightbox-image-wrapper') as HTMLElement;
      if (!wrapper) return;

      const wrapperRect = wrapper.getBoundingClientRect();
      const wrapperWidth = wrapperRect.width;
      const wrapperHeight = wrapperRect.height;
      if (!wrapperWidth || !wrapperHeight) return;

      const imageWidth = Number.parseFloat(image.getAttribute('width') || '0');
      const imageHeight = Number.parseFloat(image.getAttribute('height') || '0');
      if (!imageWidth || !imageHeight) return;

      const imageAspectRatio = imageWidth / imageHeight;
      const wrapperAspectRatio = wrapperWidth / wrapperHeight;

      let finalX = 0;
      let finalY = 0;

      if (wrapperAspectRatio > imageAspectRatio) {
        const targetHeight = wrapperHeight;
        const targetWidth = targetHeight * imageAspectRatio;
        finalX = (wrapperWidth - targetWidth) / 2;
      } else {
        const targetWidth = wrapperWidth;
        const targetHeight = targetWidth / imageAspectRatio;
        finalY = (wrapperHeight - targetHeight) / 2;
      }

      image.style.setProperty('--final-x', `${Math.max(0, finalX)}px`);
      image.style.setProperty('--final-y', `${Math.max(0, finalY)}px`);
      image.style.setProperty('--final-scale', '1');
    }

    function applyCenteringToAllImages(): void {
      document.querySelectorAll<HTMLImageElement>('.lightbox-image').forEach(calculateCentering);
    }

    // Initialize each gallery independently
    document.querySelectorAll<HTMLElement>('.pandabox-gallery').forEach((gallery) => {
      const galleryId = gallery.id.replace('gallery-', '');

      // Scoped element selectors
      const thumbnailButtons = gallery.querySelectorAll<HTMLButtonElement>('.thumbnail-strip .thumbnail-button');
      const currentImageButtons = gallery.querySelectorAll<HTMLButtonElement>('.current-image-button');
      const prevArrow = gallery.querySelector<HTMLButtonElement>('.prev-arrow');
      const nextArrow = gallery.querySelector<HTMLButtonElement>('.next-arrow');
      const lightboxDialog = gallery.querySelector<HTMLDialogElement>('.lightbox-dialog');
      const prevButton = gallery.querySelector<HTMLButtonElement>('.prev-button');
      const nextButton = gallery.querySelector<HTMLButtonElement>('.next-button');
      const closeButton = gallery.querySelector<HTMLButtonElement>('.close-button');

      const imageCount = currentImageButtons.length;
      let currentIndex = 0;

      const closeDuration = lightboxDialog
        ? parseFloat(getComputedStyle(lightboxDialog).getPropertyValue('--duration-close-transition')) * 1000
        : 500;

      // Update the current displayed image (not lightbox)
      function updateCurrentImage(index: number): void {
        if (index < 0 || index >= imageCount) return;

        currentImageButtons.forEach((btn, i) => btn.classList.toggle('active', i === index));
        thumbnailButtons.forEach((btn, i) => btn.classList.toggle('active', i === index));

        thumbnailButtons[index]?.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center',
        });

        currentIndex = index;
      }

      function showPreviousCurrentImage(): void {
        updateCurrentImage((currentIndex - 1 + imageCount) % imageCount);
      }

      function showNextCurrentImage(): void {
        updateCurrentImage((currentIndex + 1) % imageCount);
      }

      // Thumbnail click handler
      thumbnailButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = parseInt(button.dataset.index || '0', 10);
          updateCurrentImage(index);
        });
      });

      // Arrow click handlers
      prevArrow?.addEventListener('click', showPreviousCurrentImage);
      nextArrow?.addEventListener('click', showNextCurrentImage);

      function showImageAtIndex(index: number): void {
        const containers = gallery.querySelectorAll<HTMLElement>('.lightbox-image-container');
        if (index < 0 || index >= containers.length) return;

        containers.forEach(c => c.classList.remove('active', 'previous', 'next'));

        const newActiveImage = document.getElementById(`${galleryId}-image-${index}`);
        if (newActiveImage) {
          newActiveImage.classList.add('active');
          currentIndex = index;

          const image = newActiveImage.querySelector<HTMLImageElement>('.lightbox-image');
          if (image) calculateCentering(image);

          const prevIndex = (currentIndex - 1 + containers.length) % containers.length;
          const nextIndex = (currentIndex + 1) % containers.length;

          document.getElementById(`${galleryId}-image-${prevIndex}`)?.classList.add('previous');
          document.getElementById(`${galleryId}-image-${nextIndex}`)?.classList.add('next');
        }
      }

      function openLightbox(index: number): void {
        if (!lightboxDialog) return;

        const currentButton = currentImageButtons[index];
        if (!currentButton) return;

        const rect = currentButton.getBoundingClientRect();
        const activeImage = document.getElementById(`${galleryId}-image-${index}`);

        if (activeImage) {
          activeImage.classList.add('active');
          lightboxDialog.showModal();
          currentIndex = index;
          activeGalleryId = galleryId;

          requestAnimationFrame(() => {
            const lightboxWrapper = activeImage.querySelector<HTMLDivElement>('.lightbox-image-wrapper');
            if (!lightboxWrapper) return;

            const wrapperRect = lightboxWrapper.getBoundingClientRect();
            if (wrapperRect.width === 0 || wrapperRect.height === 0) return;

            const lightboxImage = activeImage.querySelector<HTMLImageElement>('.lightbox-image');
            if (lightboxImage) {
              const buttonAspectRatio = rect.width / rect.height;
              const wrapperAspectRatio = wrapperRect.width / wrapperRect.height;
              const initialScale = buttonAspectRatio > wrapperAspectRatio
                ? rect.width / wrapperRect.width
                : rect.height / wrapperRect.height;

              lightboxImage.style.setProperty('--initial-x', `${rect.left}px`);
              lightboxImage.style.setProperty('--initial-y', `${rect.top}px`);
              lightboxImage.style.setProperty('--initial-scale', `${initialScale}`);

              if (lightboxDialog.getAttribute('data-option') !== 'slide') {
                calculateCentering(lightboxImage);
              }

              showImageAtIndex(currentIndex);
            }
          });
        }
      }

      // Current image click opens lightbox
      currentImageButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = parseInt(button.dataset.index || '0', 10);
          openLightbox(index);
        });
      });

      function showPreviousImage(): void {
        showImageAtIndex((currentIndex - 1 + imageCount) % imageCount);
      }

      function showNextImage(): void {
        showImageAtIndex((currentIndex + 1) % imageCount);
      }

      function closeDialog(): void {
        if (!lightboxDialog) return;

        lightboxDialog.classList.add('closing');
        setTimeout(() => {
          lightboxDialog.close();
          lightboxDialog.classList.remove('closing');
          activeGalleryId = null;
        }, closeDuration);
      }

      // Lightbox button handlers
      prevButton?.addEventListener('click', showPreviousImage);
      nextButton?.addEventListener('click', showNextImage);
      closeButton?.addEventListener('click', closeDialog);

      // Clean up on dialog close
      lightboxDialog?.addEventListener('close', () => {
        gallery.querySelectorAll<HTMLElement>('.lightbox-image-container')
          .forEach(c => c.classList.remove('active', 'previous', 'next'));
        activeGalleryId = null;
      });

      // Keyboard handler scoped to this gallery
      function handleKeydown(event: KeyboardEvent): void {
        // If this gallery's lightbox is open
        if (lightboxDialog?.open && activeGalleryId === galleryId) {
          if (event.key === 'ArrowLeft') {
            showPreviousImage();
          } else if (event.key === 'ArrowRight') {
            showNextImage();
          } else if (event.key === 'Escape') {
            event.preventDefault();
            closeDialog();
          }
          return;
        }

        // When lightbox is closed and this gallery is focused
        const focusedGallery = document.activeElement?.closest('.pandabox-gallery');
        if (focusedGallery === gallery) {
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            showPreviousCurrentImage();
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            showNextCurrentImage();
          } else if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openLightbox(currentIndex);
          }
        }
      }

      // Swipe handler scoped to this gallery's lightbox
      function handleSwipe(event: TouchEvent): void {
        if (!lightboxDialog?.open || activeGalleryId !== galleryId) return;

        const touchStartX = event.touches[0].clientX;

        function handleTouchEnd(touchEndEvent: TouchEvent): void {
          const touchEndX = touchEndEvent.changedTouches[0].clientX;
          const deltaX = touchEndX - touchStartX;

          if (deltaX > 50) {
            showPreviousImage();
          } else if (deltaX < -50) {
            showNextImage();
          }
          document.removeEventListener('touchend', handleTouchEnd);
        }
        document.addEventListener('touchend', handleTouchEnd);
      }

      document.addEventListener('keydown', handleKeydown);
      document.addEventListener('touchstart', handleSwipe);
    });

    // Global resize handler for centering
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(applyCenteringToAllImages, 300);
    });
  });
</script>
